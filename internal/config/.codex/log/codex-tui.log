  http.Error(w, \"upstream not configured\", http.StatusBadGateway)\n+            return\n+        }\n+\n+        // Compose upstream URL: copy all query params except relay; force role/token as provided by downstream\n+        uUp, err := parseWSURL(cfg.UpstreamURL)\n+        if err != nil {\n+            http.Error(w, \"invalid upstream URL\", http.StatusBadGateway)\n+            return\n+        }\n+        uq := uUp.Query()\n+        dq := r.URL.Query()\n+        for k, vs := range dq {\n+            if k == \"relay\" {\n+                continue\n+            }\n+            for _, v := range vs {\n+                uq.Add(k, v)\n+            }\n+        }\n+        // Ensure role default if absent\n+        if dq.Get(\"role\") == \"\" && cfg.UpstreamRole != \"\" {\n+            uq.Set(\"role\", cfg.UpstreamRole)\n+        }\n+        uUp.RawQuery = uq.Encode()\n+\n+        // Dial upstream before upgrading client, so we can return 502 on failure\n+        upConn, _, err := websocket.DefaultDialer.Dial(uUp.String(), nil)\n+        if err != nil {\n+            http.Error(w, \"upstream dial failed\", http.StatusBadGateway)\n+            return\n+        }\n+\n+        // Upgrade downstream\n+        downConn, err := wsUpgrader.Upgrade(w, r, nil)\n+        if err != nil {\n+            _ = upConn.Close()\n+            log.Printf(\"downstream upgrade failed: %v\", err)\n+            return\n+        }\n+\n+        log.Printf(\"bridge connected: downstream=%s -> upstream=%s\", r.RemoteAddr, uUp.String())\n+\n+        // Pipe both ways\n+        done := make(chan struct{}, 2)\n+        go pump(downConn, upConn, cfg.MaxMessageLogBytes, \"d->u\", gate)\n+        go pump(upConn, downConn, cfg.MaxMessageLogBytes, \"u->d\", gate)\n+        <-done // unreachable; pumps exit by closing conns\n+    }\n+}\n+\n+func pump(src, dst *websocket.Conn, logLimit int, dir, gate string) {\n+    defer func() {\n+        _ = src.Close()\n+        _ = dst.Close()\n+    }()\n+    for {\n+ 