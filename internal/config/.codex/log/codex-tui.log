2026-01-15T10:06:47.784627Z  INFO codex_core::stream_events_utils: ToolCall: shell {"command":["apply_patch","*** Begin Patch\n*** Add File: internal/hub/hub.go\n+package hub\n+\n+import (\n+    \"context\"\n+    \"fmt\"\n+    \"log\"\n+    \"net/http\"\n+    \"sync\"\n+    \"time\"\n+\n+    \"github.com/gorilla/websocket\"\n+)\n+\n+type Role string\n+\n+const (\n+    RoleNewCLI Role = \"newcli\"\n+    RoleCodex  Role = \"codex\"\n+)\n+\n+type peer struct {\n+    conn   *websocket.Conn\n+    role   Role\n+    token  string\n+    closed chan struct{}\n+}\n+\n+type pair struct {\n+    token string\n+    a     *peer // newcli\n+    b     *peer // codex\n+}\n+\n+type Hub struct {\n+    mu    sync.Mutex\n+    pairs map[string]*pair\n+\n+    allowedTokens map[string]struct{}\n+    logLimit      int\n+}\n+\n+func New(allowed []string, logLimit int) *Hub {\n+    at := map[string]struct{}{}\n+    if len(allowed) > 0 {\n+        for _, t := range allowed {\n+            at[t] = struct{}{}\n+        }\n+    }\n+    return &Hub{\n+        pairs:         make(map[string]*pair),\n+        allowedTokens: at,\n+        logLimit:      logLimit,\n+    }\n+}\n+\n+var upgrader = websocket.Upgrader{\n+    ReadBufferSize:  64 << 10,\n+    WriteBufferSize: 64 << 10,\n+    CheckOrigin: func(r *http.Request) bool {\n+        // Allow all origins for demo; put your own policy here.\n+        return true\n+    },\n+}\n+\n+func (h *Hub) ServeWS(w http.ResponseWriter, r *http.Request) {\n+    q := r.URL.Query()\n+    roleStr := q.Get(\"role\")\n+    token := q.Get(\"token\")\n+    if roleStr == \"\" || token == \"\" {\n+        http.Error(w, \"missing role or token\", http.StatusBadRequest)\n+        return\n+    }\n+    if len(h.allowedTokens) > 0 {\n+        if _, ok := h.allowedTokens[token]; !ok {\n+            http.Error(w, \"token not allowed\", http.StatusForbidden)\n+            return\n+        }\n+    }\n+\n+    var role Role\n+    switch roleStr {\n+    case string(RoleNewCLI):\n+        role = RoleNewCLI\n+    case string(RoleCodex):\n+        role = RoleCodex\n+    default:\n+        http.Error(w, \"invalid role\", http.StatusBadRequest)\n+        return\n+    }\n+\n+    c, err := upgrader.Upgrade(w, r, nil)\n+    if err != nil {\n+        log.Printf(\"upgrade failed: %v\", err)\n+        return\n+    }\n+\n+    p := &peer{conn: c, role: role, token: token, closed: make(chan struct{})}\n+    pr := h.addPeer(p)\n+\n+    log.Printf(\"connected: role=%s token=%s remote=%s\", role, token, r.RemoteAddr)\n+\n+    ctx, cancel := context.WithCancel(context.Background())\n+    defer cancel()\n+\n+    // reader goroutine\n+    go func() {\n+        defer close(p.closed)\n+        for {\n+            mt, msg, err := c.ReadMessage()\n+            if err != nil {\n+                // log and break\n+                log.Printf(\"read err role=%s token=%s: %v\", role, token, err)\n+                return\n+            }\n+            h.logMsg(role, token, \"in\", mt, msg)\n+            h.forward(pr, p, mt, msg)\n+        }\n+    }()\n+\n+    // Wait until peer is closed\n+    select {\n+    case <-p.closed:\n+        // continue to cleanup\n+    case <-ctx.Done():\n+    }\n+\n+    h.removePeer(p)\n+    _ = c.Close()\n+    log.Printf(\"disconnected: role=%s token=%s\", role, token)\n+}\n+\n+func (h *Hub) logMsg(role Role, token, dir string, mt int, msg []byte) {\n+    typ := \"text\"\n+    if mt == websocket.BinaryMessage {\n+        typ = \"bin\"\n+    }\n+    preview := msg\n+    if h.logLimit > 0 && len(preview) > h.logLimit {\n+        preview = preview[:h.logLimit]\n+    }\n+    // Truncate preview at printable boundary for text.\n+    // For simplicity we print as %q (Go escapes non-printables).\n+    log.Printf(\"msg %s role=%s token=%s type=%s len=%d preview=%q\", dir, role, token, typ, len(msg), preview)\n+}\n+\n+func (h *Hub) addPeer(p *peer) *pair {\n+    h.mu.Lock()\n+    defer h.mu.Unlock()\n+    pr, ok := h.pairs[p.token]\n+    if !ok {\n+        pr = &pair{token: p.token}\n+        h.pairs[p.token] = pr\n+    }\n+    if p.role == RoleNewCLI {\n+        if pr.a != nil {\n+            // Close existing\n+            _ = pr.a.conn.WriteControl(websocket.CloseMessage, websocket.FormatCloseMessage(websocket.CloseNormalClosure, \"replaced\"), time.Now().Add(2*time.Second))\n+            _ = pr.a.conn.Close()\n+        }\n+        pr.a = p\n+    } else {\n+        if pr.b != nil {\n+            _ = pr.b.conn.WriteControl(websocket.CloseMessage, websocket.FormatCloseMessage(websocket.CloseNormalClosure, \"replaced\"), time.Now().Add(2*time.Second))\n+            _ = pr.b.conn.Close()\n+        }\n+        pr.b = p\n+    }\n+    return pr\n+}\n+\n+func (h *Hub) removePeer(p *peer) {\n+    h.mu.Lock()\n+    defer h.mu.Unlock()\n+    pr, ok := h.pairs[p.token]\n+    if !ok {\n+        return\n+    }\n+    if pr.a == p {\n+        pr.a = nil\n+    }\n+    if pr.b == p {\n+        pr.b = nil\n+    }\n+    if pr.a == nil && pr.b == nil {\n+        delete(h.pairs, p.token)\n+    }\n+}\n+\n+func (h *Hub) forward(pr *pair, src *peer, mt int, msg []byte) {\n+    dst := h.otherLocked(pr, src)\n+    if dst == nil {\n+        // no peer to forward; drop\n+        return\n+    }\n+    // Forward write with deadline\n+    dst.conn.SetWriteDeadline(time.Now().Add(30 * time.Second))\n+    if err := dst.conn.WriteMessage(mt, msg); err != nil {\n+        log.Printf(\"forward err token=%s from=%s to=%s: %v\", src.token, src.role, dst.role, err)\n+        _ = dst.conn.Close()\n+    } else {\n+        h.logMsg(src.role, src.token, fmt.Sprintf(\"out->%s\", dst.role), mt, msg)\n+    }\n+}\n+\n+func (h *Hub) otherLocked(pr *pair, src *peer) *peer {\n+    h.mu.Lock()\n+    defer h.mu.Unlock()\n+    if src.role == RoleNewCLI {\n+        return pr.b\n+    }\n+    return pr.a\n+}\n+\n*** End Patch\n"]}
