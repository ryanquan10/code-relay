d if whitelist is set\n+    _ = token\n+    backoff := time.Second\n+    for {\n+        u, err := url.Parse(rawURL)\n+        if err != nil {\n+            log.Printf(\"autoConnect: invalid URL %q: %v\", rawURL, err)\n+            return\n+        }\n+        q := u.Query()\n+        q.Set(\"role\", string(role))\n+        q.Set(\"token\", token)\n+        u.RawQuery = q.Encode()\n+\n+        log.Printf(\"autoConnect: dialing %s\", u.String())\n+        c, _, err := websocket.DefaultDialer.Dial(u.String(), nil)\n+        if err != nil {\n+            log.Printf(\"autoConnect: dial failed: %v\", err)\n+            time.Sleep(backoff)\n+            if backoff < 30*time.Second {\n+                backoff *= 2\n+            }\n+            continue\n+        }\n+        backoff = time.Second\n+        h.Attach(role, token, c, \"upstream\")\n+        // Attach returns after connection closes; loop to reconnect\n+        time.Sleep(time.Second)\n+    }\n+}\n+\n+func consoleBridge(h *hub.Hub, token string, role hub.Role) {\n+    if token == \"\" {\n+        log.Printf(\"consoleTest enabled but no token available; provide allowedTokens or upstreamToken\")\n+        return\n+    }\n+    // Connect to our own server\n+    u := url.URL{Scheme: \"ws\", Host: strings.TrimPrefix(strings.TrimPrefix(strings.TrimPrefix(\"\"+\"localhost\"+cfgListenPort(), \":\"), \"ws://\"), \"http://\"), Path: \"/ws\"}\n+    q := u.Query()\n+    q.Set(\"role\", string(role))\n+    q.Set(\"token\", token)\n+    u.RawQuery = q.Encode()\n+\n+    c, _, err := websocket.DefaultDialer.Dial(u.String(), nil)\n+    if err != nil {\n+        log.Printf(\"consoleBridge dial failed: %v\", err)\n+        return\n+    }\n+    defer c.Close()\n+\n+    // Read pump: print messages from peer to stdout\n+    done := make(chan struct{})\n+    go func() {\n+        defer close(done)\n+        for {\n+            mt, msg, err := c.ReadMessage()\n+            if err != nil {\n+                log.Printf(\"consoleBridge 