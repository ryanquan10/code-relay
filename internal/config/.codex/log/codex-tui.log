2026-01-15T16:12:55.742741Z  INFO codex_core::stream_events_utils: ToolCall: shell {"command":["apply_patch","*** Begin Patch\n*** Add File: main.go\n+package main\n+\n+import (\n+    \"flag\"\n+    \"fmt\"\n+    \"log\"\n+    \"net/http\"\n+    \"os\"\n+\n+    \"codex-relay/internal/config\"\n+    \"codex-relay/internal/hub\"\n+)\n+\n+func main() {\n+    var (\n+        addrFlag   string\n+        configPath string\n+    )\n+\n+    flag.StringVar(&addrFlag, \"addr\", \"\", \"listen address, e.g. :8080\")\n+    flag.StringVar(&configPath, \"config\", \"\", \"config JSON path (default: %USERPROFILE%/.codex/relay.json)\")\n+    flag.Parse()\n+\n+    cfg, err := config.Load(configPath)\n+    if err != nil {\n+        log.Fatalf(\"load config: %v\", err)\n+    }\n+    if addrFlag != \"\" {\n+        cfg.ListenAddr = addrFlag\n+    }\n+\n+    h := hub.New(cfg.AllowedTokens, cfg.MaxMessageLogBytes)\n+\n+    mux := http.NewServeMux()\n+    mux.HandleFunc(\"/healthz\", func(w http.ResponseWriter, r *http.Request) {\n+        w.WriteHeader(http.StatusOK)\n+        _, _ = w.Write([]byte(\"ok\"))\n+    })\n+    mux.HandleFunc(\"/ws\", h.ServeWS)\n+\n+    log.Printf(\"starting relay on %s\", cfg.ListenAddr)\n+    log.Printf(\"allowed tokens: %s\", summarizeTokens(cfg.AllowedTokens))\n+    if err := http.ListenAndServe(cfg.ListenAddr, logRequest(mux)); err != nil {\n+        log.Fatalf(\"server error: %v\", err)\n+    }\n+}\n+\n+func summarizeTokens(ts []string) string {\n+    if len(ts) == 0 {\n+        return \"<any>\"\n+    }\n+    if len(ts) <= 5 {\n+        return fmt.Sprintf(\"%v\", ts)\n+    }\n+    return fmt.Sprintf(\"%v (+%d more)\", ts[:5], len(ts)-5)\n+}\n+\n+func logRequest(next http.Handler) http.Handler {\n+    return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n+        log.Printf(\"%s %s from %s\", r.Method, r.URL.String(), r.RemoteAddr)\n+        next.ServeHTTP(w, r)\n+    })\n+}\n+\n*** End Patch"], "timeout_ms": 120000}
